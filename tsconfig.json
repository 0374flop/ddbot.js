{
  "compilerOptions": {
    "rootDir": "./src/bot",
    "outDir": "./lib",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "target": "esnext",
    "types": ["node"],
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/bot/**/*"],
  "exclude": ["lib/**/**/*", "node_modules"]
}